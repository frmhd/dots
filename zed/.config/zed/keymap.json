// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      // "ctrl-alt-b": [
      //   "action::Sequence",
      //   [
      //     "workspace::ToggleRightDock",
      //     ["task::Spawn", { "task_name": "Toggle Niri Fullscreen" }],
      //   ],
      // ],
      "ctrl-k a o": ["task::Spawn", { "task_name": "OpenCode" }],
      "ctrl-k a p": ["task::Spawn", { "task_name": "pi" }],
      "ctrl-k a g": ["task::Spawn", { "task_name": "Gemini CLI" }],
      "ctrl-k a c": ["task::Spawn", { "task_name": "Cursor CLI" }],
      "ctrl-k j": ["task::Spawn", { "task_name": "Alacritty" }],
      "ctrl-shift-g": [
        "action::Sequence",
        ["git::Diff", "git_panel::ToggleFocus"],
      ],
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
    },
  },
  {
    "bindings": {
      "ctrl-k r": "workspace::CopyRelativePath",
    },
  },
  {
    "context": "(Editor && (edit_prediction && (showing_completions || in_leading_whitespace)))",
    "bindings": {
      "alt-1": "editor::AcceptEditPrediction",
    },
  },
  {
    "context": "(Editor && edit_prediction)",
    "bindings": {
      "alt-1": "editor::AcceptEditPrediction",
    },
  },
  {
    "bindings": {
      "ctrl-alt-shift-b": "git::BranchDiff",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-alt-shift-b": "git::Branch",
    },
  },
]

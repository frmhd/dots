        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^git\\b",
            },
          ],
        },
      },
    },
    "single_file_review": true,
    "default_model": {
      "effort": "max",
      "provider": "opencode-go",
      "model": "deepseek-v4-flash",
      "enable_thinking": true,
    },
    "favorite_models": [

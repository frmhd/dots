// Layer rules configuration
layer-rule {
    match namespace="^dms:notification-popup$"

    block-out-from "screen-capture"
}

layer-rule {
    match namespace="waybar"

    opacity 1.0
    background-effect {
        // xray true
        blur false
    }
}

layer-rule {
    match namespace="^launcher$"

    geometry-corner-radius 4

    shadow {
        on
        softness 15
        spread 0
        offset x=0 y=0
        draw-behind-window true
        color "#00000030"
    }
}

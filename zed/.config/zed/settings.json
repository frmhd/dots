  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "project_panel": {
    "dock": "left",
  },
  "git_panel": {
    "group_by": "staging",
    "dock": "left",
    "tree_view": true,
  },
  "agent": {
    "default_width": 700,
    "flexible": false,
    "thinking_display": "auto",
    "expand_edit_card": true,
    "expand_terminal_card": false,
    "play_sound_when_agent_done": "always",
    "sidebar_side": "right",
    "dock": "right",
    "commit_message_instructions": "You are a commit message generator. Follow the Conventional Commits specification: <type>[optional scope]: <description> [optional body] [optional footer(s)] Rules: - Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert - Description: imperative mood, lowercase, no period, max 72 chars - Add ! after type/scope for breaking changes, or BREAKING CHANGE: footer - Body: explain what and why, wrap at 72 chars - Output only the commit message, no preamble or quotes",
    "commit_message_model": {
      "provider": "opencode-go",
      "model": "deepseek-v4-flash",
      "enable_thinking": true,
      "speed": "standard",
    },
    "tool_permissions": {
